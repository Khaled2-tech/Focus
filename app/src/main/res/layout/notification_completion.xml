<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_comp_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_notif_card"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_focus_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#7A6F9E"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_comp_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تنبيه"
            android:textColor="#C3BCDE"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_comp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="انتهت جلسة المذاكرة!"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_comp_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:text="أحسنت! لقد أنهيت جلسة المذاكرة!"
        android:textColor="#DDD8F5"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="right|center_vertical">

        <LinearLayout
            android:id="@+id/notif_comp_action1"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_notif_button"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:id="@+id/notif_comp_icon1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_clock_white" />

            <TextView
                android:id="@+id/notif_comp_text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وقت إضافي"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_comp_action2"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_notif_button_subtle"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:id="@+id/notif_comp_icon2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_close_white" />

            <TextView
                android:id="@+id/notif_comp_text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إيقاف"
                android:textColor="#E8E4FD"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
